DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-aiven-password

# Optional if you place the Aiven CA bundle at certs/ca.pem.
# You can also set DB_CA_CERT to the full PEM contents in Vercel.
# DB_CA_CERT=

# Option A: complete value from Cloudinary Console > Settings > API Keys
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Option B: remove CLOUDINARY_URL and set all three values instead
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
